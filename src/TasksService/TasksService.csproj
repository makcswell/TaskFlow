<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TasksService.Data\TaskFlow.Data.csproj"/>
        <ProjectReference Include="..\TasksService.Client\TaskFlow.Client.csproj"/>
        <ProjectReference Include="..\TasksService.Routes\TaskFlow.Routes.csproj"/>
    </ItemGroup>
    <!--Copy models xmls from stc nuget packages to build folder for swagger-->
    <Target Name="_ResolveCopyLocalNuGetPkgXmls" AfterTargets="ResolveReferences">
        <ItemGroup>
            <ReferenceCopyLocalPaths Include="@(ReferenceCopyLocalPaths->'%(RootDir)%(Directory)..\..\contentFiles\%(Filename).xml')" Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)'!='' and Exists('%(RootDir)%(Directory)..\..\contentFiles\%(Filename).xml')"/>
        </ItemGroup>
    </Target>

    <ItemGroup>
        <PackageReference Include="Ebceys.Infrastructure" Version="1.0.58"/>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Versioning" Version="5.1.0"/>
    </ItemGroup>

</Project>